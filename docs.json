{
  "$schema": "https://mintlify.com/docs.json",
  "name": "commitdog",
  "theme": "mint",
  "colors": {
    "primary": "#FEB300",
    "light": "#FEB300",
    "dark": "#FEB300"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/aysdog/commitdog"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Get Started",
        "pages": [
          "introduction",
          "installation",
          "setup"
        ]
      },
      {
        "group": "Core Commands",
        "pages": [
          "commands/commit",
          "commands/branch",
          "commands/sync",
          "commands/pr",
          "commands/stash",
          "commands/revert"
        ]
      },
      {
        "group": "Releasing",
        "pages": [
          "release/overview",
          "release/targets",
          "release/changelog"
        ]
      },
      {
        "group": "Security",
        "pages": [
          "security/secret-detection",
          "security/history-scan"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/configuration",
          "reference/platforms",
          "reference/mirrors",
          "reference/troubleshooting"
        ]
      }
    ]
  },
  "fonts": {
    "heading": {
      "family": "Geist"
    }
  },
  "description": "Fastest Git workflow CLI for solo devs and teams.",
  "logo": {
    "light": "/images/logo.svg",
    "dark": "/images/logo.svg"
  },
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "dark"
  }
}
